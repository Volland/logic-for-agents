#lf
% The chain again, with the recursive rule first and its
% premises in the other order. Depth-first search loops.
person : type.
anna  : person.
marco : person.
sofia : person.
reports_to : person -> person -> type.
rt_marco : reports_to marco anna.
rt_sofia : reports_to sofia marco.
chain : person -> person -> type.
% ANCHOR: loop
step : chain X Z <- chain Y Z <- reports_to X Y.
one  : chain X Y <- reports_to X Y.
% ANCHOR_END: loop
