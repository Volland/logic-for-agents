% Chapter 8: a rule that loops, and fuel that stops it.
accumulate world.

kind rname type.
type same_org, boss, sym rname.

pred colleague o:person, o:person.

% ANCHOR: rules
pred rule o:rname, o:prop, o:prop.
rule same_org (colleague X Y)
  (works_at X O, works_at Y O,
   differ X Y).
rule boss (colleague X Y)
  (reports_to X Y).
rule sym (colleague X Y)
  (colleague Y X).
% ANCHOR_END: rules

pred direct o:prop, o:string.
direct (works_at _ _)   "memory".
direct (reports_to _ _) "memory".
direct (differ _ _)     "check".

pred differ i:person, i:person.
differ X Y :- not (X = Y).

kind proof type.
type empty proof.
type leaf string -> prop -> proof.
type by rname -> prop -> proof -> proof.
type and proof -> proof -> proof.

% ANCHOR: solve
% solve Fuel Goal Proof FuelLeft
pred solve i:int, i:prop, o:proof,
           o:int.
solve F true empty F.
solve F0 (A, B) (and P Q) F :-
  solve F0 A P F1,
  solve F1 B Q F.
solve F G (leaf From G) F :-
  direct G From, G.
solve F0 G (by N G P) F :-
  F0 > 0, F1 is F0 - 1,
  rule N G Body,
  solve F1 Body P F.
% ANCHOR_END: solve

pred explain i:string, i:proof.
explain _ empty.
explain In (and P Q) :- explain In P, explain In Q.
explain In (leaf From G) :- line In G From.
explain In (by N G P) :-
  term_to_string N Name, line In G Name,
  In2 is In ^ "  ", explain In2 P.

pred line i:string, i:prop, i:string.
line In G Why :-
  term_to_string G S,
  L is In ^ S ^ " [" ^ Why ^ "]", print L.

% ANCHOR: why
pred why i:int, i:prop.
why F G :-
  solve F G P Left, !,
  explain "" P,
  Used is F - Left,
  print "fuel used:" Used.
why F G :-
  print "no proof with fuel" F,
  print "  for" G.
% ANCHOR_END: why

% ANCHOR: main
main :-
  why 10 (colleague lena taras),
  why 10 (colleague anna lena),
  why 1 (colleague lena taras).
% ANCHOR_END: main
