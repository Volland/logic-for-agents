% Chapter 6: when is a claim true in the memory?
% Loaded with `accumulate holds.`
accumulate lang.

% ANCHOR: yes_no
% Chapter 4's helper: run G once,
% then say yes or no.
pred yes_no i:prop, i:string.
yes_no G Label :-
  (G, print Label "yes"
   ; print Label "no").
% ANCHOR_END: yes_no

% ANCHOR: facts
pred people o:list person.
people [anna, marco, lena,
        taras, sofia].

pred attends o:int, o:person.
attends E P :-
  event E _ Who _ _ _,
  std.mem Who P.

% who got the slides of event E
pred slides o:int, o:person.
slides 1 anna.
slides 1 marco.
% ANCHOR_END: facts

% ANCHOR: holds_atoms
pred holds i:claim.
holds (att E P) :- attends E P.
holds (got E P) :- slides E P.
holds (rep P M) :- reports_to P M.
% ANCHOR_END: holds_atoms
% ANCHOR: holds_connectives
holds (and A B) :- holds A,
                   holds B.
holds (imp A _) :- not (holds A).
holds (imp A B) :- holds A,
                   holds B.
% ANCHOR_END: holds_connectives
% ANCHOR: holds_all
holds (all F) :-
  people Ps,
  std.forall Ps (p\ holds (F p)).
% ANCHOR_END: holds_all
% ANCHOR: holds_ex
holds (ex F) :-
  people Ps,
  std.mem Ps P,
  holds (F P).
% ANCHOR_END: holds_ex

% ANCHOR: witness
pred witness i:claim, o:person.
witness (ex F) P :-
  people Ps, std.mem Ps P,
  holds (F P).
% ANCHOR_END: witness
