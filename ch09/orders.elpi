% Chapter 9: when the store must choose.
accumulate world.
accumulate time.

constraint leq {
  rule \ (leq X X).
  rule (leq X Y) \ (leq X Y).
  rule (leq X Y) \ (leq Y X) <=> (X = Y).
  rule (leq X Y) (leq Y Z) <=> (leq X Z).
}

pred leq o:time, o:time.
leq A B :- var A, !,
  declare_constraint (leq A B) [A, B].
leq A B :- var B, !,
  declare_constraint (leq A B) [A, B].
leq A B :- minutes A MA, minutes B MB, MA =< MB.

pred at o:person, o:city, o:time, o:time.
at P C S E :-
  declare_constraint (at P C S E) [S, E].

constraint at {
  rule (at P C1 S1 E1) (at P C2 S2 E2)
    | (not (C1 = C2))
    <=> (apart S1 E1 S2 E2).
}

pred apart o:time, o:time, o:time, o:time.
apart _ E1 S2 _ :- leq E1 S2.
apart S1 _ _ E2 :- leq E2 S1.

pred attend i:list person, i:city, o:time, o:time.
attend Who C S E :-
  leq S E, std.forall Who (p\ at p C S E).

% ANCHOR: probe
pred probe i:time, i:time.
probe S T :-
  (S = T, print "  could start at" T,
   fail ; true).
% ANCHOR_END: probe

% ANCHOR: main
main :-
  (attend [anna] lisbon
          (d 2000 10) (d 2000 11),
   attend [anna] berlin S _E,
   print "an answer:",
   probe S (d 2000 8),
   probe S (d 2000 12),
   fail
  ; print "no more answers").
% ANCHOR_END: main
