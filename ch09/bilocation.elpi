% Chapter 9: no bilocation, as a constraint rule.
accumulate world.
accumulate time.

constraint leq {
  rule \ (leq X X).
  rule (leq X Y) \ (leq X Y).
  rule (leq X Y) \ (leq Y X) <=> (X = Y).
  rule (leq X Y) (leq Y Z) <=> (leq X Z).
}

pred leq o:time, o:time.
leq A B :- var A, !,
  declare_constraint
    (leq A B) [A, B].
leq A B :- var B, !,
  declare_constraint
    (leq A B) [A, B].
leq A B :- minutes A MA, minutes B MB, MA =< MB.

pred tell i:string, i:prop.
tell Said G :- G, !,
  print "ok:" Said.
tell Said _ :-
  print "no:" Said.

% ANCHOR: at
% P is in city C from S to E.
pred at o:person, o:city,
        o:time, o:time.
at P C S E :-
  declare_constraint
    (at P C S E) [S, E].
% ANCHOR_END: at

% ANCHOR: rule
constraint at {
  rule (at P C1 S1 E1)
       (at P C2 S2 E2)
    | (not (C1 = C2))
    <=> (apart S1 E1 S2 E2).
}
% ANCHOR_END: rule

% ANCHOR: apart
% One stay ends first.
pred apart o:time, o:time,
           o:time, o:time.
apart _ E1 S2 _ :- leq E1 S2.
apart S1 _ _ E2 :- leq E2 S1.
% ANCHOR_END: apart

% ANCHOR: attend
pred attend i:list person, i:city,
            o:time, o:time.
attend Who C S E :-
  leq S E,
  std.forall Who (p\ at p C S E).
% ANCHOR_END: attend

% ANCHOR: remember
% Physical events from memory.
pred remember.
remember :-
  std.findall
    (event _ _ _ _ _ _) Es,
  std.forall Es store.

pred store i:prop.
store (event _ K W C S E) :-
  physical K, !, attend W C S E.
store _.
% ANCHOR_END: remember

% ANCHOR: phantom
pred phantom.
phantom :-
  tell "Anna met Lena in Berlin"
       (attend [anna, lena] berlin
               S (d 2000 12)),
  tell "it began at 10:00"
       (S = d 2000 10),
  print "S:" S.
% ANCHOR_END: phantom

% ANCHOR: main
main :- remember, phantom.
% ANCHOR_END: main
