% Chapter 9: a cycle of "no later than" collapses.
accumulate world.
accumulate time.

% ANCHOR: chr
constraint leq {
  rule \ (leq X X).
  rule (leq X Y) \ (leq X Y).
  rule (leq X Y) \ (leq Y X)
    <=> (X = Y).
  rule (leq X Y) (leq Y Z)
    <=> (leq X Z).
}
% ANCHOR_END: chr

% ANCHOR: leq
% leq A B: A is no later than B.
pred leq o:time, o:time.
leq A B :- var A, !,
  declare_constraint
    (leq A B) [A, B].
leq A B :- var B, !,
  declare_constraint
    (leq A B) [A, B].
leq A B :-
  minutes A MA, minutes B MB,
  MA =< MB.
% ANCHOR_END: leq

% ANCHOR: cycle
pred cycle.
cycle :-
  leq A B, leq B C, leq C A,
  print "A B C:" A B C.
% ANCHOR_END: cycle

main :- cycle.
