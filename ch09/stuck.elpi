% Chapter 9: two waiting goals that cannot see each other.
accumulate world.
accumulate time.

% ANCHOR: waits
pred later o:time, i:time.
later T Ref :-
  declare_constraint
    (before Ref T) [T].

pred earlier o:time, i:time.
earlier T Ref :-
  declare_constraint
    (before T Ref) [T].
% ANCHOR_END: waits

pred tell i:string, i:prop.
tell Said G :- G, !, print "ok:" Said.
tell Said _ :- print "no:" Said.

% ANCHOR: main
main :-
  tell "after 11:00"
       (later S (d 2000 11)),
  tell "before 9:00"
       (earlier S (d 2000 9)).
% ANCHOR_END: main
