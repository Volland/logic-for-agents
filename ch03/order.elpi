% Chapter 3: clause order changes the order of answers.
accumulate world.
accumulate show.

reports_to sofia marco.

% ANCHOR: chain
pred chain_of_command
  o:person, o:person.
chain_of_command P M :-
  reports_to P M.
chain_of_command P M :-
  reports_to P B,
  chain_of_command B M.
% ANCHOR_END: chain

% ANCHOR: flipped
pred chain_flipped
  o:person, o:person.
chain_flipped P M :-
  reports_to P B,
  chain_flipped B M.
chain_flipped P M :-
  reports_to P M.
% ANCHOR_END: flipped

% ANCHOR: q
main :-
  show (chain_of_command sofia M),
  show (chain_flipped sofia M).
% ANCHOR_END: q
